# A fast-growing fintech scale-up on community edition: about 320 engineers in
# 40 teams, grouped under three directors (the units under the CTO): payments,
# lending, and platform.
#
# Vault started as one shared cluster with team prefixes, which still holds
# the early services. As the directors' groups grew, each wanted to run its
# own Vault, and without Enterprise namespaces the only way to do that was a
# cluster of its own. So the newer services sit in a cluster per unit, laid out
# environment first, while the original cluster carries on beside them.
#
# The original services run on two Kubernetes clusters. The unit clusters'
# services spread over three more and four AWS accounts, all logging in
# through one AWS mount, and their ops groups never agreed on a policy
# style: most write tidy per-app policies, some template them, a few still
# have the shared login and wildcards of the early days. Identity isn't
# managed: people's policies sit on their logins.
#
# Community at scale: separation by cluster sprawl instead of namespaces.

cluster "scaleup" {
  edition      = "community"
  industry     = "fintech"
  environments = ["dev", "staging", "prod"]
  seed         = 1

  model "original" {
    apps      = 40
    namespace = "none"
    env       = "after-app"
    platforms = { vm = "40%", kubernetes = "40%", legacy = "20%" }
    databases = "60%"

    kubernetes_clusters = 2
  }

  model "unit-clusters" {
    apps      = 80
    namespace = "per-unit"
    env       = "first"
    platforms = { kubernetes = "75%", lambda = "25%" }
    databases = "40%"

    kubernetes_clusters = 3
    aws_accounts        = 4
    policies            = { per-app = "50%", templated = "30%", legacy = "20%" }
  }
}
